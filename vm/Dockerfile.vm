# Elazya VM Root Filesystem
# Minimal Alpine Linux with Node.js 22 and the compiled Elazya agent bundle.
# This runs INSIDE the VM — fully isolated from the host macOS.

FROM alpine:3.20

# System packages
RUN apk add --no-cache \
    nodejs=~22 \
    npm \
    bash \
    ca-certificates \
    curl \
    git \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ttf-freefont \
    && rm -rf /var/cache/apk/*

# Set Chromium flags for headless browser agent
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV CHROMIUM_FLAGS="--no-sandbox --disable-gpu --disable-dev-shm-usage"

# Copy the compiled Elazya agent bundle
WORKDIR /app
COPY dist/ ./dist/
COPY package.json pnpm-lock.yaml ./
COPY node_modules/ ./node_modules/

# Copy the VM init script
COPY vm/init.sh /init.sh
RUN chmod +x /init.sh

# Copy the kernel (for extraction by Makefile)
RUN apk add --no-cache linux-lts \
    && cp /boot/vmlinuz-lts /boot/vmlinuz \
    && cp /boot/initramfs-lts /boot/initrd \
    && apk del linux-lts

# Default: run init script
CMD ["/init.sh"]
