#!/bin/bash
# Locate resources relative to the bundle
# The binary is in Contents/MacOS/binaries/, resources are in Contents/Resources/engine/
RES_DIR="$(dirname "$0")/../../Resources/engine"

# Ensure we're using absolute paths if dirname returns relative
if [[ "$RES_DIR" != /* ]]; then
  RES_DIR="$(cd "$(dirname "$0")/../../Resources/engine" && pwd)"
fi

# Execute bundled node with bundled script
if [ -f "$RES_DIR/node" ] && [ -f "$RES_DIR/openclaw.mjs" ]; then
  "$RES_DIR/node" "$RES_DIR/openclaw.mjs" "$@"
else
  echo "Error: Engine resources not found at $RES_DIR" >&2
  exit 1
fi
