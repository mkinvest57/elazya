#!/usr/bin/expect -f
set timeout 60
spawn ssh su594661@access-5019523613.webspace-host.com
expect {
    "password:" { send "Yassine.2011\r" }
    "(yes/no)?" { send "yes\r"; exp_continue }
}
expect -re {[$#] ?$}

send "cd elazya-server\r"
expect -re {[$#] ?$}

# Write test.js
send "echo \"console.log('Start'); setInterval(() => console.log('Tick'), 1000);\" > test.js\r"
expect -re {[$#] ?$}

# Run it
send "node test.js > test_out.log 2>&1 &\r"
sleep 5

# Check ps
send "ps aux | grep node\r"
expect -re {[$#] ?$}

# Check logs
send "cat test_out.log\r"
expect -re {[$#] ?$}

send "killall -u su594661 node\r"
send "exit\r"
