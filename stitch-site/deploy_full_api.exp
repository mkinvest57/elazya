#!/usr/bin/expect -f
set timeout 300
spawn sftp su594661@access-5019523613.webspace-host.com
expect {
    "password:" { send "Yassine.2011\r" }
    "(yes/no)?" { send "yes\r"; exp_continue }
}
expect "sftp>"

send "put server_full.tar.gz elazya-server/\r"
expect "sftp>"

send "bye\r"

spawn ssh su594661@access-5019523613.webspace-host.com
expect {
    "password:" { send "Yassine.2011\r" }
}
expect -re {[$#] ?$}

send "cd elazya-server\r"
expect -re {[$#] ?$}

send "killall -u su594661 node\r"
expect -re {[$#] ?$}

send "tar -xzf server_full.tar.gz\r"
expect -re {[$#] ?$}

send "rm server_full.tar.gz\r"
expect -re {[$#] ?$}

# The "start.sh" uses "server.js", but server.js was meant for standalone mode.
# Let's fix start.sh to use `npm start` instead of `node server.js`
send "cat << 'INNER_EOF' > start.sh\n#!/bin/bash\nexport PORT=3002\nexport NODE_ENV=production\nnohup npm start --max-old-space-size=256 </dev/null >stdout.log 2>stderr.log &\ndisown\nINNER_EOF\n"
expect -re {[$#] ?$}

send "chmod +x start.sh\r"
expect -re {[$#] ?$}

# Reinstall production node_modules just in case standalone erased them
send "npm ci --production\r"
expect -re {[$#] ?$}

send "curl -s http://localhost/start_node2.php\r"
expect -re {[$#] ?$}

send "sleep 2\r"
expect -re {[$#] ?$}

send "ps ux | grep node\r"
expect -re {[$#] ?$}

send "exit\r"
