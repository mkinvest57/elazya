#!/usr/bin/expect -f
set timeout 30
spawn ssh su594661@access-5019523613.webspace-host.com
expect {
    "password:" { send "Yassine.2011\r" }
    "(yes/no)?" { send "yes\r"; exp_continue }
}
expect -re {[$#] ?$}

# Create candidate roots
send "mkdir -p public_html htdocs\r"
expect -re {[$#] ?$}

# Copy hello.html
send "cp hello.html public_html/\r"
expect -re {[$#] ?$}
send "cp hello.html htdocs/\r"
expect -re {[$#] ?$}

# Check permissions
send "chmod 755 public_html htdocs\r"
expect -re {[$#] ?$}
send "chmod 644 public_html/hello.html htdocs/hello.html\r"
expect -re {[$#] ?$}

send "exit\r"
