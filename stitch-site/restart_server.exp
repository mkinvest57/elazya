#!/usr/bin/expect -f
set timeout 30
spawn ssh su594661@access-5019523613.webspace-host.com
expect {
    "password:" { send "Yassine.2011\r" }
    "(yes/no)?" { send "yes\r"; exp_continue }
}
expect -re {[$#] ?$}

# Kill node (watchdog will restart it)
send "killall -u su594661 node\r"
expect -re {[$#] ?$}

# Wait for restart
sleep 5

# Verify
send "ps aux | grep node\r"
expect -re {[$#] ?$}

# Check start logs
send "tail -n 20 elazya-server/watchdog.log\r"
expect -re {[$#] ?$}

# Final Check
send "wget -O - http://localhost:3000 | head -n 20\r"
expect -re {[$#] ?$}

send "exit\r"
