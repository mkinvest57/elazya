#!/usr/bin/expect -f
set timeout 300
spawn ssh su594661@access-5019523613.webspace-host.com
expect {
    "password:" { send "Yassine.2011\r" }
    "(yes/no)?" { send "yes\r"; exp_continue }
}
expect -re {[$#] ?$}

# 1. Kill old processes
send "killall -u su594661 node\r"
expect -re {[$#] ?$}

# 2. Cleanup old deployment
send "rm -rf elazya-server\r"
expect -re {[$#] ?$}

send "mkdir elazya-server\r"
expect -re {[$#] ?$}

# 3. Extract new release
send "tar -xzf release.tar.gz -C elazya-server\r"
expect -re {[$#] ?$}

# 4. Cleanup tarball (optional)
# send "rm release.tar.gz\r"
# expect -re {[$#] ?$}

send "cd elazya-server\r"
expect -re {[$#] ?$}

# 5. Start Server
# Assuming pm2 is included in node_modules from local build
send "./node_modules/.bin/pm2 start ecosystem.config.js\r"
expect {
    "No process found" {
        send "./node_modules/.bin/pm2 start ecosystem.config.js -f\r"
    }
    -re {[$#] ?$}
}

send "./node_modules/.bin/pm2 save\r"
expect -re {[$#] ?$}

send "exit\r"
