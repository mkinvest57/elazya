#!/usr/bin/expect -f
set timeout 60
spawn ssh su594661@access-5019523613.webspace-host.com
expect {
    "password:" { send "Yassine.2011\r" }
    "(yes/no)?" { send "yes\r"; exp_continue }
}
expect -re {[$#] ?$}

send "killall -u su594661 node\r"
expect -re {[$#] ?$}

send "cd elazya-server\r"
expect -re {[$#] ?$}

# Start node in background of THIS session
send "node server.js > stdout.log 2> stderr.log &\r"
sleep 5

# Check if running
send "ps aux | grep node\r"
expect -re {[$#] ?$}

# Check logs
send "cat stdout.log\r"
expect -re {[$#] ?$}
send "cat stderr.log\r"
expect -re {[$#] ?$}

# Check wget
send "wget -qO- http://localhost:3000 | head -n 5\r"
expect -re {[$#] ?$}

# Cleanup
send "killall -u su594661 node\r"

send "exit\r"
