#!/usr/bin/expect -f
set timeout 30
spawn ssh su594661@access-5019523613.webspace-host.com
expect {
    "password:" { send "Yassine.2011\r" }
    "(yes/no)?" { send "yes\r"; exp_continue }
}
expect -re {[$#] ?$}

send "cd elazya-server\r"
expect -re {[$#] ?$}

# Remove old
send "rm -rf node_modules/@prisma/client node_modules/.prisma\r"
expect -re {[$#] ?$}

# Extract
send "tar -xzf ~/prisma_musl_full.tar.gz\r"
expect -re {[$#] ?$}

# Set env var and run check
# Point to Musl binary
send "export PRISMA_QUERY_ENGINE_BINARY=/home/www/elazya-server/node_modules/.prisma/client/query-engine-linux-musl-openssl-3.0.x\r"
expect -re {[$#] ?$}

# Also ensure execution permission
send "chmod +x /home/www/elazya-server/node_modules/.prisma/client/query-engine-linux-musl-openssl-3.0.x\r"
expect -re {[$#] ?$}

send "node check_prisma.js\r"
expect -re {[$#] ?$}

send "exit\r"
