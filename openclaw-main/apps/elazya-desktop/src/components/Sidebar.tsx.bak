import { useState, useEffect } from 'react';
import { OpenClawClient, ChannelStatus } from '@/lib/openclaw-client';
import { Zap, Settings, HardDrive, Cpu } from 'lucide-react';
import { listen } from '@tauri-apps/api/event';

interface SidebarProps {
    currentView: string;
    onChangeView: (view: string) => void;
}

export default function Sidebar({ currentView, onChangeView }: SidebarProps) {
    const [usage, setUsage] = useState<any>(null);
    const [channels, setChannels] = useState<ChannelStatus[]>([]);
    const [skills, setSkills] = useState<string[]>([]);
    const [provider, setProvider] = useState<string>('...');
    const [model, setModel] = useState<string>('...');

    useEffect(() => {
        // Initial fetch
        OpenClawClient.getUsageStats().then(setUsage);
        OpenClawClient.getChannelsStatus().then(setChannels);
        OpenClawClient.getInstalledSkills().then(setSkills);
        OpenClawClient.getSetting('alize_provider').then(p => setProvider(p || 'Inconnu'));
        OpenClawClient.getSetting('alize_model').then(m => setModel(m || 'Inconnu'));

        // Listen for live updates
        const unlisten = listen('token-usage-update', (event) => {
            setUsage(event.payload);
        });

        // Polling for channels/skills (simpler than watching files for now)
        const interval = setInterval(() => {
            OpenClawClient.getChannelsStatus().then(setChannels);
        }, 5000);

        return () => {
            unlisten.then(f => f());
            clearInterval(interval);
        };
    }, []);

    const monthlyTotal = usage?.monthly?.total || 0;
    const monthlyLimit = 1000000;
    const percentUsed = (monthlyTotal / monthlyLimit) * 100;
    const estimatedCost = (monthlyTotal / 1000000) * 15.00; // Approx $15/1M input/output blend

    return (
        <div className="w-80 glass-panel border-r border-white/5 h-full flex flex-col p-6 space-y-8 overflow-y-auto font-sans relative z-20">
            <h1
                onClick={() => onChangeView('dashboard')}
                className="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-white to-white/50 px-2 tracking-tight cursor-pointer hover:opacity-80 transition-opacity"
            >
                Alizé
            </h1>

            {/* Status Card - Click to go to Dashboard/System */}
            <div
                onClick={() => onChangeView('dashboard')}
                className={`bg-white/5 rounded-2xl p-5 border border-white/5 space-y-4 shadow-lg backdrop-blur-md relative overflow-hidden group cursor-pointer transition-all ${currentView === 'dashboard' ? 'ring-1 ring-blue-500/50 bg-white/10' : 'hover:bg-white/10'}`}
            >
                <div className="absolute inset-0 bg-gradient-to-br from-blue-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

                <div className="flex items-center gap-3 relative">
                    <div className="relative">
                        <div className="w-2.5 h-2.5 rounded-full bg-green-500 shadow-[0_0_10px_rgba(34,197,94,0.5)]"></div>
                        <div className="absolute inset-0 w-2.5 h-2.5 rounded-full bg-green-500 animate-ping opacity-75"></div>
                    </div>
                    <span className="text-[10px] font-bold uppercase tracking-[0.2em] text-zinc-400">Système Actif</span>
                </div>

                <div className="flex items-center gap-3 relative">
                    <div className="p-2 bg-blue-500/20 rounded-lg text-blue-400">
                        <Cpu className="w-5 h-5" />
                    </div>
                    <div className="flex-1 overflow-hidden">
                        <p className="text-white text-sm font-bold truncate tracking-wide">{provider}</p>
                        <p className="text-zinc-500 text-[10px] truncate font-medium">{model}</p>
                    </div>
                </div>
            </div>

            {/* Token Usage */}
            <div className="space-y-4">
                <h3 className="text-[10px] font-black text-zinc-600 uppercase tracking-[0.2em] px-2 flex items-center gap-2">
                    <Zap className="w-3 h-3" /> Consommation
                </h3>
                <div className="bg-white/5 rounded-2xl p-5 border border-white/5 space-y-5">
                    <div>
                        <div className="flex justify-between text-xs mb-2 items-center">
                            <span className="text-zinc-400 font-medium">Session</span>
                            <span className="text-white font-mono bg-white/10 px-2 py-0.5 rounded text-[10px]">{usage?.session?.total?.toLocaleString() || 0} toks</span>
                        </div>
                        <div className="flex justify-between text-[10px] text-zinc-600 font-medium">
                            <span>In: {usage?.session?.input || 0}</span>
                            <span>Out: {usage?.session?.output || 0}</span>
                        </div>
                    </div>

                    <div className="pt-4 border-t border-white/5">
                        <div className="flex justify-between text-xs mb-3 items-center">
                            <span className="text-zinc-400 font-medium">Quota Mensuel</span>
                            <span className="text-white font-mono">{percentUsed.toFixed(1)}%</span>
                        </div>
                        <div className="w-full bg-zinc-800 rounded-full h-1.5 overflow-hidden ring-1 ring-white/5">
                            <div className="bg-gradient-to-r from-blue-600 to-cyan-400 h-full rounded-full transition-all duration-1000 shadow-[0_0_10px_rgba(59,130,246,0.5)]" style={{ width: `${Math.min(percentUsed, 100)}%` }}></div>
                        </div>
                        <p className="text-[10px] text-zinc-500 mt-3 text-right font-mono">Est. ${estimatedCost.toFixed(2)}</p>
                    </div>
                </div>
            </div>

            {/* Channels - Click to go to Chat */}
            <div className="space-y-4">
                <h3 className="text-[10px] font-black text-zinc-600 uppercase tracking-[0.2em] px-2 flex items-center gap-2">
                    <Zap className="w-3 h-3" /> Canaux
                </h3>
                <div className="space-y-1">
                    {channels.map(c => (
                        <div
                            key={c.id}
                            onClick={() => onChangeView('chat')}
                            className={`flex items-center justify-between p-3 rounded-xl cursor-pointer group transition-all duration-300 ${currentView === 'chat' ? 'bg-white/10 border border-white/5 shadow-inner' : 'hover:bg-white/5 border border-transparent'}`}
                        >
                            <div className="flex items-center gap-3">
                                <span className="text-lg opacity-60 group-hover:opacity-100 group-hover:scale-110 transition-all duration-300">
                                    {c.id === 'whatsapp' ? '💬' : c.id === 'telegram' ? '✈️' : c.id === 'discord' ? '🎮' : '🔌'}
                                </span>
                                <span className="text-sm font-medium text-zinc-400 group-hover:text-white transition-colors">{c.name}</span>
                            </div>
                            {c.connected ? (
                                <div className="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.6)]"></div>
                            ) : (
                                <div className="w-1.5 h-1.5 rounded-full bg-zinc-700"></div>
                            )}
                        </div>
                    ))}
                </div>
            </div>

            {/* Skills */}
            <div className="space-y-4">
                <h3 className="text-[10px] font-black text-zinc-600 uppercase tracking-[0.2em] px-2 flex items-center gap-2">
                    <HardDrive className="w-3 h-3" /> Compétences
                </h3>
                <div className="space-y-2">
                    {skills.length === 0 ? (
                        <p className="text-xs text-zinc-600 px-2 italic font-medium">Aucune compétence installée.</p>
                    ) : skills.map(s => (
                        <div key={s} className="flex items-center gap-3 p-3 rounded-xl hover:bg-white/5 transition-all group border border-transparent hover:border-white/5">
                            <div className="p-1.5 rounded-lg bg-purple-500/10 text-purple-400 group-hover:bg-purple-500/20 transition-colors">
                                <HardDrive className="w-3 h-3" />
                            </div>
                            <span className="text-xs font-semibold text-zinc-400 group-hover:text-zinc-200 transition-colors truncate">{s}</span>
                        </div>
                    ))}
                </div>
            </div>

            <div className="mt-auto pt-6 border-t border-white/5">
                <button className="flex items-center gap-3 text-xs font-bold text-zinc-500 hover:text-white transition-all w-full p-3 rounded-xl hover:bg-white/5 group">
                    <Settings className="w-4 h-4 group-hover:rotate-90 transition-transform duration-500" />
                    <span>Paramètres</span>
                </button>
            </div>
        </div>
    );
}
