#!/bin/bash
echo "[DEBUG SCRIPT] Starting OpenClaw wrapper..." >&2

SCRIPT_DIR="$(dirname "$0")"

POSSIBLE_DIRS=(
  "$SCRIPT_DIR/../Resources/resources/engine"
  "$SCRIPT_DIR/../../resources/engine"
  "$SCRIPT_DIR/../resources/engine"
  "$SCRIPT_DIR/resources/engine"
  "$PWD/resources/engine"
)

RES_DIR=""
for dir in "${POSSIBLE_DIRS[@]}"; do
  abs_dir=$(cd "$dir" 2>/dev/null && pwd)
  if [ -n "$abs_dir" ] && [ -f "$abs_dir/node" ] && [ -f "$abs_dir/openclaw.mjs" ]; then
    RES_DIR="$abs_dir"
    break
  fi
done

if [ -n "$RES_DIR" ]; then
  echo "[DEBUG SCRIPT] Found resources at $RES_DIR" >&2
  
  # Log env to verify OPENCLAW_CONFIG_PATH
  echo "[DEBUG SCRIPT] ENV:" >&2
  env | grep OPENCLAW >&2
  
  exec "$RES_DIR/node" "$RES_DIR/openclaw.mjs" "$@"
else
  echo "[DEBUG SCRIPT] Error: Engine resources (node, openclaw.mjs) not found." >&2
  exit 1
fi
